# ============================================================================
# BIMRACE Lead Engine — environment variables
#
# PUBLIC (safe in the browser, constrained by RLS):
#   these go in web/config.js, which is gitignored only to keep environments
#   separate — the anon key itself is designed to be published.
# ============================================================================
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_publishable_key

# ============================================================================
# SECRET — Edge Function / server side ONLY. Set with `supabase secrets set`.
# NEVER commit these. NEVER place them in web/ or site/.
# ============================================================================
# SUPABASE_SERVICE_ROLE_KEY=   set via: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# TURNSTILE_SECRET=            optional Cloudflare Turnstile secret
# IP_SALT=                     random string used to hash visitor IPs
# ALLOWED_ORIGIN=              https://bimrace.com
